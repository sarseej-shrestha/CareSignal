// CareSignal — Prisma schema
// SQLite for hackathon speed; swappable to Postgres later by changing the datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id          String       @id @default(uuid())
  mrn         String       @unique
  firstName   String
  lastName    String
  phone       String       @unique
  cancerType  String
  chemoCycle  String
  treatmentFrequency String @default("every_3_weeks") // "weekly" | "every_2_weeks" | "every_3_weeks" | "monthly" — how often the patient's regimen brings them in, based on the standard dosing schedule for that regimen type (not a real scheduling feed). Drives the SDOH transportation suggestion trigger — see lib/transportationResources.ts.
  parish      String // e.g. "Terrebonne", "Lafourche"
  preferredLanguage String @default("en") // "en", "fr", or "es" — outbound SMS is sent in this language, see lib/i18n.ts
  riskStatus  String       @default("GREEN") // GREEN, YELLOW, RED — TODAY's symptom risk
  riskScore   Float        @default(0) // daily risk model probability 0-1
  hospitalizationRiskScore Float @default(0) // separate model: probability of hospitalization within the next 7 days — a different time horizon and claim from riskStatus/riskScore, never merged into it
  caregiver   Caregiver?
  symptomLogs SymptomLog[]
  alerts      RiskAlert[]
  soapNotes   SoapNote[]
  communications CommunicationMessage[]
  createdAt   DateTime     @default(now())
}

model Caregiver {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  phone         String         @unique
  relationship  String
  preferredLanguage String     @default("en") // independent of the patient's — a caregiver may prefer a different language
  patientId     String         @unique
  patient       Patient        @relation(fields: [patientId], references: [id])
  caregiverLogs CaregiverLog[]
}

model SymptomLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  pain       Int
  nausea     Int
  fatigue    Int
  fever      Float
  rawSmsText String?
  parsedByAi Boolean  @default(false) // true if LLM-parsed from freeform text
  source     String   @default("PATIENT_SMS") // PATIENT_SMS, CAREGIVER_SMS, WEB
  needCategory String @default("CLINICAL") // CLINICAL | LOGISTICAL | EMOTIONAL | FINANCIAL | ROUTINE | UNCERTAIN — see lib/needCategory.ts. LLM-derived for freeform text, deterministically CLINICAL for structured numeric reports.
  createdAt  DateTime @default(now())
}

model CaregiverLog {
  id            String    @id @default(uuid())
  caregiverId   String
  caregiver     Caregiver @relation(fields: [caregiverId], references: [id])
  patientStatus Int // 1-5
  copingScore   Int // 1-5, 1 = overwhelmed
  rawSmsText    String?
  createdAt     DateTime  @default(now())
}

model RiskAlert {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  level     String // YELLOW, RED, CAREGIVER_BURDEN
  reasons   String // JSON array of human-readable reasons
  modelProb Float? // classifier output, if applicable
  // OPEN -> REVIEWED -> ACTIONED -> RESOLVED. Was OPEN/ACKNOWLEDGED/RESOLVED
  // (a plain string column, not a real enum, so renaming ACKNOWLEDGED ->
  // REVIEWED is a value change, not a migration) — extended for the
  // closed-loop communication feature: REVIEWED means a clinician looked at
  // it (was "Claimed"), ACTIONED means a clinician took a concrete action
  // (currently: sent an outbound reply — see lib/communications.ts), and
  // neither implies RESOLVED. Communication is not the same thing as
  // resolution; only an explicit "Resolve" sets RESOLVED. See
  // app/api/alerts/[id]/status/route.ts.
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

// A generic communication log — one table for every direction/participant
// combination (patient-in, patient-out, caregiver-in, caregiver-out) rather
// than separate PatientMessage/CaregiverMessage/NurseMessage tables. This is
// NOT a new pipeline: inbound rows are written by the EXISTING
// recordSymptomLog/recordSafetyAlert/recordCaregiverLog functions
// (lib/inbound.ts) as an additional persistence step alongside what they
// already do — the safety/risk/need-routing logic in those functions is
// completely unmodified. Outbound rows are written by lib/communications.ts.
//
// relatedAlertId is a loose reference (no FK relation), matching this
// codebase's existing pattern for cross-references that outlive the thing
// they point to (e.g. SoapNote.sourceLogs) — an alert's lifecycle (status
// changes, but rows are never deleted) doesn't need to be constrained by a
// hard relation for this to stay meaningful.
model CommunicationMessage {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  participant String // "PATIENT" | "CAREGIVER" — who the human side of this message is, independent of direction
  direction   String // "INBOUND" | "OUTBOUND"
  body        String
  // RECEIVED (always the value for inbound) | SENT | FAILED (outbound only —
  // never "SENT" unless Twilio actually accepted it; see lib/twilioClient.ts)
  status      String   @default("RECEIVED")
  relatedAlertId String? // the RiskAlert/need this message relates to, if known — see comment above
  // Self-reported, NOT authenticated identity — this application has no
  // clinician login/session system (see docs/pitch-notes.md's security
  // scope note). A clinician types their own name when sending; nothing
  // verifies it. Honest about what it is: an audit-trail convenience, not
  // access control.
  sentByName  String?
  // Twilio's message SID, only set on an actually-accepted OUTBOUND send —
  // provenance only. No delivery-status webhook is implemented, so this
  // does not mean "delivered," only "Twilio accepted the send request."
  twilioSid   String?
  createdAt   DateTime @default(now())
}

// SOAP notes are their own first-class entity, not a field bolted onto
// RiskAlert — a note can exist (and be reviewed) for any patient, not only
// one with an open alert, and its review lifecycle is independent of the
// alert's. status starts "DRAFT" and can only become "REVIEWED" through the
// explicit review endpoint (app/api/ai/soap-note/[id]/review) — there is no
// code path that creates a note already marked reviewed. See
// components/SoapNoteGenerator.tsx and docs/pitch-notes.md's SOAP note
// safety section.
model SoapNote {
  id                String    @id @default(uuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id])
  subjective        String
  objective         String
  assessment        String
  plan              String
  fullText          String
  confidenceLevel   String // "HIGH" | "LIMITED" — a deterministic heuristic (lib/soapNoteConfidence.ts), not the LLM self-assessing
  confidenceReasons String // JSON array of human-readable reasons for a LIMITED rating
  sourceLogs        String // JSON array of the exact check-ins (id, dateLabel, source, pain, nausea, fatigue, fever) fed into generation, captured at generation time — not a live re-query, since the 7-day window could shift and no longer match what the LLM actually saw. Lets a nurse cross-check the note's claims against real source data in a few seconds — see components/SoapNoteGenerator.tsx.
  status            String    @default("DRAFT") // DRAFT | REVIEWED
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
}

// CareSignal — Prisma schema
// SQLite for hackathon speed; swappable to Postgres later by changing the datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id          String       @id @default(uuid())
  mrn         String       @unique
  firstName   String
  lastName    String
  phone       String       @unique
  cancerType  String
  chemoCycle  String
  treatmentFrequency String @default("every_3_weeks") // "weekly" | "every_2_weeks" | "every_3_weeks" | "monthly" — how often the patient's regimen brings them in, based on the standard dosing schedule for that regimen type (not a real scheduling feed). Drives the SDOH transportation suggestion trigger — see lib/transportationResources.ts.
  parish      String // e.g. "Terrebonne", "Lafourche"
  preferredLanguage String @default("en") // "en", "fr", or "es" — outbound SMS is sent in this language, see lib/i18n.ts
  riskStatus  String       @default("GREEN") // GREEN, YELLOW, RED — TODAY's symptom risk
  riskScore   Float        @default(0) // daily risk model probability 0-1
  hospitalizationRiskScore Float @default(0) // separate model: probability of hospitalization within the next 7 days — a different time horizon and claim from riskStatus/riskScore, never merged into it
  caregiver   Caregiver?
  symptomLogs SymptomLog[]
  alerts      RiskAlert[]
  soapNotes   SoapNote[]
  createdAt   DateTime     @default(now())
}

model Caregiver {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  phone         String         @unique
  relationship  String
  preferredLanguage String     @default("en") // independent of the patient's — a caregiver may prefer a different language
  patientId     String         @unique
  patient       Patient        @relation(fields: [patientId], references: [id])
  caregiverLogs CaregiverLog[]
}

model SymptomLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  pain       Int
  nausea     Int
  fatigue    Int
  fever      Float
  rawSmsText String?
  parsedByAi Boolean  @default(false) // true if LLM-parsed from freeform text
  source     String   @default("PATIENT_SMS") // PATIENT_SMS, CAREGIVER_SMS, WEB
  createdAt  DateTime @default(now())
}

model CaregiverLog {
  id            String    @id @default(uuid())
  caregiverId   String
  caregiver     Caregiver @relation(fields: [caregiverId], references: [id])
  patientStatus Int // 1-5
  copingScore   Int // 1-5, 1 = overwhelmed
  rawSmsText    String?
  createdAt     DateTime  @default(now())
}

model RiskAlert {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  level     String // YELLOW, RED, CAREGIVER_BURDEN
  reasons   String // JSON array of human-readable reasons
  modelProb Float? // classifier output, if applicable
  status    String   @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  createdAt DateTime @default(now())
}

// SOAP notes are their own first-class entity, not a field bolted onto
// RiskAlert — a note can exist (and be reviewed) for any patient, not only
// one with an open alert, and its review lifecycle is independent of the
// alert's. status starts "DRAFT" and can only become "REVIEWED" through the
// explicit review endpoint (app/api/ai/soap-note/[id]/review) — there is no
// code path that creates a note already marked reviewed. See
// components/SoapNoteGenerator.tsx and docs/pitch-notes.md's SOAP note
// safety section.
model SoapNote {
  id                String    @id @default(uuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id])
  subjective        String
  objective         String
  assessment        String
  plan              String
  fullText          String
  confidenceLevel   String // "HIGH" | "LIMITED" — a deterministic heuristic (lib/soapNoteConfidence.ts), not the LLM self-assessing
  confidenceReasons String // JSON array of human-readable reasons for a LIMITED rating
  sourceLogs        String // JSON array of the exact check-ins (id, dateLabel, source, pain, nausea, fatigue, fever) fed into generation, captured at generation time — not a live re-query, since the 7-day window could shift and no longer match what the LLM actually saw. Lets a nurse cross-check the note's claims against real source data in a few seconds — see components/SoapNoteGenerator.tsx.
  status            String    @default("DRAFT") // DRAFT | REVIEWED
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
}
